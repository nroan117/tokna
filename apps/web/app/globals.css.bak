@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --color-primary: #f97316;
  --color-primary-dark: #ea580c;
  --color-primary-darker: #c2410c;
  --color-bg: #ffffff;
  --color-text: #111827;
  --color-muted: #6b7280;
  --color-border: #e5e7eb;
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html,
body {
  max-width: 100vw;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', sans-serif;
  background: #ffffff;
  color: #111827;
}

a {
  color: inherit;
  text-decoration: none;
}

@keyframes scrollLeft {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.marquee-track {
  animation: scrollLeft 28s linear infinite;
}

.marquee-track:hover {
  animation-play-state: paused;
}

/* Dashboard card hover effect */
.dashboard-card {
  transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease !important;
}

.dashboard-card:hover {
  box-shadow: 0 8px 24px 0 rgb(0 0 0 / 0.12), 0 0 0 1.5px rgba(249, 115, 22, 0.25) !important;
  transform: translateY(-2px);
  border-color: rgba(249, 115, 22, 0.3) !important;
}

/* ===== MOBILE RESPONSIVE ===== */
@media (max-width: 768px) {
  .nav-links { display: none !important; }
  .hero-grid { grid-template-columns: 1fr !important; gap: 2rem !important; }
  .hero-section { padding: 3rem 1.25rem 2.5rem !important; }
  .approach-grid { grid-template-columns: 1fr !important; }
  .product-tabs-row { flex-wrap: wrap !important; gap: 0.25rem !important; }
  .product-tabs-grid { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
  .stats-grid { grid-template-columns: 1fr !important; }
  .persona-tabs-row { flex-wrap: wrap !important; gap: 0.25rem !important; }
  .persona-tabs-grid { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
  .footer-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 2rem !important; }
  .cta-strip-buttons { flex-direction: column !important; align-items: center !important; }
}
